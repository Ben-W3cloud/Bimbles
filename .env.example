# ── Bimbles Backend Configuration ──

# Server port (default: 3000)
PORT=3000

# Groq API key (required for AI question generation)
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Redis connection URL (optional, caching layer)
# Default: redis://localhost:6379
# Set to empty to run without Redis (AI gen still works, just uncached)
REDIS_URL=redis://localhost:6379

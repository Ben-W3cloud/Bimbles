# ── Bimbles Frontend Configuration ──

# Backend API URL (default: empty = same origin)
# In development with Vite proxy, leave empty.
# In production, set to your backend URL e.g. https://api.bimbles.app
VITE_API_URL=

# WebSocket URL (default: ws://<current host>)
# In development with Vite proxy, leave empty.
# In production, set to your backend WS URL e.g. wss://api.bimbles.app
VITE_WS_URL=
